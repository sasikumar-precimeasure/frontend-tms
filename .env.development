# Development Environment Configuration

# API Configuration
VITE_API_BASE_URL=https://tmsdev.cmsprecimeasure.cloud

# Local Modbus gateway service (server/) - owns the real TCP socket to hardware
VITE_MODBUS_GATEWAY_URL=http://localhost:4000

# App Configuration
VITE_APP_NAME=Temperature Monitoring System
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_DEVTOOLS=true

# Other Development Settings
VITE_API_TIMEOUT=30000
